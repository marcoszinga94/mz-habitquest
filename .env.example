# Neon (Postgres serverless)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar sesiones (JWT). Genera uno con: openssl rand -base64 32
AUTH_SECRET=""

# Entorno: development | production (Vercel lo define solo)
# NODE_ENV="development"

# Notificaciones push (Web Push). Genera las claves con:
#   npx web-push generate-vapid-keys --json
# La pública va con prefijo PUBLIC_ (se expone al cliente).
PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@habitquest.dev"

# Protege el cron de recordatorios (Vercel la envía como Authorization Bearer)
CRON_SECRET=""
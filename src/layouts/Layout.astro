---
import '../styles/global.css';
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="HabitQuest — convierte tus hábitos en una aventura RPG. Reta a tus amigos y gana." />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
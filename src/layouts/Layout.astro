---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <meta name="description" content="HabitQuest — convierte tus hábitos en una aventura RPG. Reta a tus amigos y gana." />
    <meta name="theme-color" content="#0a0814" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="HabitQuest" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Inter:wght@400;600;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="bg-scene" aria-hidden="true">
      <div class="sky"></div>
      <div class="landscape">
        <svg viewBox="0 0 1440 420" preserveAspectRatio="none" class="absolute bottom-0 left-0 w-full h-full">
          <defs>
            <linearGradient id="mtnFar" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#2a2055" stop-opacity="0.55" />
              <stop offset="1" stop-color="#0b0919" />
            </linearGradient>
            <linearGradient id="mtnNear" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#191237" stop-opacity="0.95" />
              <stop offset="1" stop-color="#0a0816" />
            </linearGradient>
          </defs>
          <path fill="url(#mtnFar)" d="M0,260 L90,150 L200,240 L340,120 L480,270 L620,150 L760,260 L900,140 L1040,260 L1180,150 L1320,250 L1440,180 L1440,420 L0,420 Z" />
          <path fill="url(#mtnNear)" d="M0,330 L120,210 L250,320 L400,180 L560,340 L700,220 L860,330 L1020,200 L1180,340 L1320,230 L1440,320 L1440,420 L0,420 Z" />
        </svg>
      </div>
      <div class="aurora"></div>
      <div class="fog"></div>
      <div class="dust"></div>
      <div class="bonfire">
        <div class="bonfire-glow"></div>
        <svg class="fire-svg" viewBox="0 0 160 120" preserveAspectRatio="none">
          <defs>
            <linearGradient id="flameOuter" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0" stop-color="#ffd166" stop-opacity="0.95" />
              <stop offset="0.5" stop-color="#fb923c" stop-opacity="0.7" />
              <stop offset="1" stop-color="#ea580c" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="flameInner" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0" stop-color="#fff7d6" stop-opacity="0.95" />
              <stop offset="0.55" stop-color="#ffd166" stop-opacity="0.6" />
              <stop offset="1" stop-color="#fb923c" stop-opacity="0" />
            </linearGradient>
          </defs>
          <g>
            <rect x="32" y="94" width="96" height="13" rx="6.5" fill="#5b3a1e" />
            <rect x="26" y="82" width="106" height="13" rx="6.5" fill="#6b4423" transform="rotate(-11 79 88)" />
            <rect x="28" y="82" width="106" height="13" rx="6.5" fill="#4e3018" transform="rotate(11 81 88)" />
          </g>
          <g>
            <ellipse cx="14" cy="106" rx="11" ry="8" fill="#4a4a55" />
            <ellipse cx="146" cy="106" rx="11" ry="8" fill="#4a4a55" />
            <ellipse cx="38" cy="112" rx="10" ry="7" fill="#55555f" />
            <ellipse cx="122" cy="112" rx="10" ry="7" fill="#55555f" />
            <ellipse cx="80" cy="114" rx="12" ry="8" fill="#3c3c47" />
          </g>
          <path class="flame flame-outer" d="M80,8 C90,30 112,46 112,72 C112,96 94,104 80,110 C66,104 48,96 48,72 C48,46 70,30 80,8 Z" fill="url(#flameOuter)" />
          <path class="flame flame-inner" d="M80,30 C88,46 100,60 100,80 C100,94 90,102 80,108 C70,102 60,94 60,80 C60,60 72,46 80,30 Z" fill="url(#flameInner)" />
        </svg>
      </div>
      <div class="embers">
        <i style="--x:8%;--d:0s;--t:9s;--dx:-6px"></i>
        <i style="--x:22%;--d:2s;--t:11s;--dx:8px"></i>
        <i style="--x:36%;--d:5s;--t:8s;--dx:-10px"></i>
        <i style="--x:44%;--d:1s;--t:12s;--dx:4px"></i>
        <i style="--x:50%;--d:6s;--t:9s;--dx:-4px"></i>
        <i style="--x:54%;--d:0.5s;--t:10s;--dx:7px"></i>
        <i style="--x:60%;--d:3s;--t:8s;--dx:-8px"></i>
        <i style="--x:70%;--d:7s;--t:10s;--dx:5px"></i>
        <i style="--x:82%;--d:4s;--t:11s;--dx:-5px"></i>
        <i style="--x:90%;--d:8s;--t:9s;--dx:6px"></i>
        <i style="--x:46%;--d:9s;--t:13s;--dx:3px"></i>
        <i style="--x:56%;--d:2.5s;--t:7s;--dx:-3px"></i>
      </div>
    </div>
    <div class="vignette" aria-hidden="true"></div>
    <ClientRouter />
    <div class="content-layer">
      <slot />
    </div>
    {
      import.meta.env.PROD && (
        <script>
          if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').catch(() => {});
          }
        </script>
      )
    }
  </body>
</html>